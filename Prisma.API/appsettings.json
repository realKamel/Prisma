{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} < framework: {SourceContext} >{NewLine}{Exception}"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/api-log-.json",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 14,
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341",
          "apiKey": null,
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "Prisma.API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultSqlConnection": "",
    "Redis": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryInMinutes": 15,
    "RefreshTokenExpiryInDays": 7
  },
  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": ""
  },
  "PaymobSettings": {
    "NotificationUrl": "https://prisma.runasp.net/api/v1/payments/webhook",
    "RedirectionUrl": "https://prisma.runasp.net/payment/callback",
    "PublicKey": "",
    "SecretKey": "",
    "IframeId": "",
    "HmacSecret": "",
    "CardIntegrationId": 0,
    "FawryIntegrationId": 0
  },
  "OpenAI": {
    "ApiKey": "",
    "FastChatModel": "openai/gpt-4o-mini",
    "ReasoningModel": "openai/gpt-4o-mini",
    "SpeechModel": "openai/whisper-1",
    "EmbeddingModel": "openai/text-embedding-3-small"
  },
  "Groq": {
    "ApiKey": "",
    "Model": "llama-3.3-70b-versatile"
  },
  "Storage": {
    "ServiceUrl": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "prisma-bucket",
    "PublicPrefixes": [
      "lessons/thumbnails"
    ],
    "ForcePathStyle": true
  },
  "VideoStorage": {
    "BucketName": "prisma-videos"
  },
  "Mux": {
    "TokenId": "",
    "TokenSecret": "",
    "SigningKeyId": "",
    "SigningPrivateKey": ""
  },
  "deploymentUrls": {
    "backendUrl": "",
    "frontendUrl": "https://prisma.runasp.net"
  },
  "IdentitySeed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminPhone": ""
  },
  "FeatureManagement": {
    "AiGrading": true,
    "AiRagChat": true,
    "WeeklyStudentReportUsingAi": true
  },
  "AllowedHosts": "*"
}
